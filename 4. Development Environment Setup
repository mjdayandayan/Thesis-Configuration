## INSTALL PYTHON DEPENDENCIES
  # Create project directory
  mkdir -p ~/thesis
  cd ~/thesis

  # Create virtual environment
  python3 -m venv venv
  source venv/bin/activate

  # Install required packages
  pip install --upgrade pip
  pip install adafruit-circuitpython-dht adafruit-circuitpython-ads1x15
  pip install opencv-python numpy pillow
  pip install edge_impulse_linux  # For Edge Impulse model inference
  pip install paho-mqtt           # For data transmission (optional)
  pip install flask               # For local web dashboard (optional)

