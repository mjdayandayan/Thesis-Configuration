"""
Edge Impulse model inference for plant disease/health classification
"""

import cv2
import numpy as np
from edge_impulse_linux.image import ImageImpulseRunner

import sys
sys.path.append('/home/pi/rice-paddy-monitor')
from config.settings import MODEL_PATH


class PlantClassifier:
    """Edge Impulse image classification wrapper"""
    
    def __init__(self, model_path=MODEL_PATH):
        self.model_path = model_path
        self.runner = None
        self.labels = None
        self.input_width = None
        self.input_height = None
    
    def load(self):
        """Load the Edge Impulse model"""
        print(f"Loading model from {self.model_path}...")
        
        self.runner = ImageImpulseRunner(self.model_path)
        model_info = self.runner.init()
        
        print(f"Model: {model_info['project']['name']}")
        print(f"Version: {model_info['project']['deploy_version']}")
        
        self.labels = model_info['model_parameters']['labels']
        self.input_width = model_info['model_parameters']['image_input_width']
        self.input_height = model_info['model_parameters']['image_input_height']
        
        print(f"Input size: {self.input_width}x{self.input_height}")
        print(f"Labels: {self.labels}")
        
        return self
    
    def preprocess(self, frame):
        """
        Preprocess image for model input.
        
        Args:
            frame: BGR or RGB image (numpy array)
            
        Returns:
            numpy.ndarray: Preprocessed image
        """
        # Resize to model input size
        resized = cv2.resize(frame, (self.input_width, self.input_height))
        
        # Convert BGR to RGB if needed (Edge Impulse expects RGB)
        if len(resized.shape) == 3 and resized.shape[2] == 3:
            # Assume input is BGR from OpenCV
            rgb = cv2.cvtColor(resized, cv2.COLOR_BGR2RGB)
        else:
            rgb = resized
        
        return rgb
    
    def classify(self, frame):
        """
        Run classification on an image.
        
        Args:
            frame: BGR image from camera
            
        Returns:
            dict: {
                'predictions': [{'label': str, 'confidence': float}, ...],
                'top_prediction': {'label': str, 'confidence': float},
                'inference_time_ms': float
            }
        """
        if self.runner is None:
            self.load()
        
        # Preprocess
        processed = self.preprocess(frame)
        
        # Run inference
        features, cropped = self.runner.get_features_from_image(processed)
        result = self.runner.classify(features)
        
        # Parse results
        predictions = []
        for label in self.labels:
            if label in result['result']['classification']:
                confidence = result['result']['classification'][label]
                predictions.append({
                    'label': label,
                    'confidence': round(confidence, 4)
                })
        
        # Sort by confidence
        predictions.sort(key=lambda x: x['confidence'], reverse=True)
        
        return {
            'predictions': predictions,
            'top_prediction': predictions[0] if predictions else None,
            'inference_time_ms': result['timing']['classification']
        }
    
    def close(self):
        """Release model resources"""
        if self.runner is not None:
            self.runner.stop()
            self.runner = None
            print("Model unloaded")
    
    def __enter__(self):
        return self.load()
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.close()


# Test inference if run directly
if __name__ == "__main__":
    from camera import Camera
    
    print("Testing Edge Impulse inference...")
    
    try:
        with Camera() as cam, PlantClassifier() as classifier:
            for i in range(3):
                print(f"\n--- Test {i+1} ---")
                frame = cam.capture()
                
                if frame is not None:
                    result = classifier.classify(frame)
                    
                    print(f"Top prediction: {result['top_prediction']['label']}")
                    print(f"Confidence: {result['top_prediction']['confidence']:.2%}")
                    print(f"Inference time: {result['inference_time_ms']:.1f}ms")
                    
                    print("All predictions:")
                    for pred in result['predictions']:
                        print(f"  {pred['label']}: {pred['confidence']:.2%}")
                
                input("Press Enter for next capture...")
                
    except FileNotFoundError:
        print(f"Model file not found at {MODEL_PATH}")
        print("Please copy your .eim file to the models/ directory")
    except Exception as e:
