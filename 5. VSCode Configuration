"""
Rice Paddy Monitoring System - Main Application
Combines sensor readings, camera capture, and ML inference
"""

import time
import json
import os
from datetime import datetime
import threading

import sys
sys.path.append('/home/pi/rice-paddy-monitor')

from config.settings import (
    LOG_INTERVAL_SECONDS, DATA_DIR, LOG_DIR,
    TEMP_MIN, TEMP_MAX, HUMIDITY_MIN, HUMIDITY_MAX, SOIL_MOISTURE_MIN
)
from src.sensors import SensorHub
from src.camera import Camera
from src.inference import PlantClassifier


class RicePaddyMonitor:
    """Main monitoring application"""
    
    def __init__(self):
        self.sensors = None
        self.camera = None
        self.classifier = None
        self.running = False
        self._ensure_directories()
    
    def _ensure_directories(self):
        """Create required directories if they don't exist"""
        os.makedirs(DATA_DIR, exist_ok=True)
        os.makedirs(LOG_DIR, exist_ok=True)
    
    def initialize(self):
        """Initialize all components"""
        print("=" * 50)
        print("Rice Paddy Monitoring System")
        print("=" * 50)
        
        print("\n[1/3] Initializing sensors...")
        self.sensors = SensorHub()
        
        print("\n[2/3] Initializing camera...")
        self.camera = Camera()
        self.camera.open()
        
        print("\n[3/3] Loading ML model...")
        try:
            self.classifier = PlantClassifier()
            self.classifier.load()
        except FileNotFoundError:
            print("WARNING: Model file not found. Inference disabled.")
            self.classifier = None
        
        print("\n" + "=" * 50)
        print("System initialized successfully!")
        print("=" * 50)
    
    def check_alerts(self, data):
        """Check sensor values against thresholds and generate alerts"""
        alerts = []
        
        if data['temperature'] is not None:
            if data['temperature'] < TEMP_MIN:
                alerts.append(f"LOW TEMPERATURE: {data['temperature']}°C (min: {TEMP_MIN}°C)")
            elif data['temperature'] > TEMP_MAX:
                alerts.append(f"HIGH TEMPERATURE: {data['temperature']}°C (max: {TEMP_MAX}°C)")
        
        if data['humidity'] is not None:
            if data['humidity'] < HUMIDITY_MIN:
                alerts.append(f"LOW HUMIDITY: {data['humidity']}% (min: {HUMIDITY_MIN}%)")
            elif data['humidity'] > HUMIDITY_MAX:
                alerts.append(f"HIGH HUMIDITY: {data['humidity']}% (max: {HUMIDITY_MAX}%)")
        
        if data['soil_moisture_percent'] is not None:
            if data['soil_moisture_percent'] < SOIL_MOISTURE_MIN:
                alerts.append(f"LOW SOIL MOISTURE: {data['soil_moisture_percent']}% (min: {SOIL_MOISTURE_MIN}%)")
        
        return alerts
    
    def collect_data(self):
        """Collect data from all sources"""
        # Read sensors
        sensor_data = self.sensors.read_all()
        
        # Capture and classify image
        frame = self.camera.capture()
        classification = None
        
        if frame is not None and self.classifier is not None:
            classification = self.classifier.classify(frame)
            
            # Save image with classification result
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            label = classification['top_prediction']['label'].replace(' ', '_')
            filename = f"{timestamp}_{label}.jpg"
            self.camera.save_image(frame, filename)
        
        # Combine data
        combined = {
            **sensor_data,
            'classification': classification['top_prediction'] if classification else None,
            'all_predictions': classification['predictions'] if classification else None
        }
        
        return combined
    
    def log_data(self, data):
        """Save data to daily log file"""
        date_str = datetime.now().strftime('%Y-%m-%d')
        log_file = os.path.join(LOG_DIR, f"log_{date_str}.jsonl")
        
        with open(log_file, 'a') as f:
            f.write(json.dumps(data) + '\n')
    
    def display_status(self, data):
        """Print current status to console"""
        print("\n" + "-" * 40)
        print(f"Timestamp: {data['timestamp']}")
        print(f"Temperature: {data['temperature']}°C")
        print(f"Humidity: {data['humidity']}%")
        print(f"Soil Moisture: {data['soil_moisture_percent']}%")
        
        if data['classification']:
            print(f"Plant Status: {data['classification']['label']} "
                  f"({data['classification']['confidence']:.1%})")
        
        # Check and display alerts
        alerts = self.check_alerts(data)
        if alerts:
            print("\n⚠️  ALERTS:")
            for alert in alerts:
                print(f"   - {alert}")
        
        print("-" * 40)
    
    def run_once(self):
        """Perform a single monitoring cycle"""
        data = self.collect_data()
        self.display_status(data)
        self.log_data(data)
        return data
    
    def run_continuous(self, interval=LOG_INTERVAL_SECONDS):
        """Run continuous monitoring loop"""
        self.running = True
        print(f"\nStarting continuous monitoring (interval: {interval}s)")
        print("Press Ctrl+C to stop\n")
        
        try:
            while self.running:
                self.run_once()
                
                # Sleep in small increments to allow clean shutdown
                for _ in range(interval):
                    if not self.running:
                        break
                    time.sleep(1)
                    
        except KeyboardInterrupt:
            print("\nStopping monitoring...")
            self.running = False
    
    def cleanup(self):
        """Clean up all resources"""
        print("\nCleaning up...")
        
        if self.sensors:
            self.sensors.cleanup()
        
        if self.camera:
            self.camera.close()
        
        if self.classifier:
            self.classifier.close()
        
        print("Cleanup complete")


def main():
    """Entry point"""
    monitor = RicePaddyMonitor()
    
    try:
        monitor.initialize()
        
        # Run once for testing, or run continuously
        import sys
        if len(sys.argv) > 1 and sys.argv[1] == '--once':
            monitor.run_once()
        else:
            monitor.run_continuous()
            
    except Exception as e:
        print(f"Error: {e}")
        raise
    finally:
        monitor.cleanup()


if __name__ == "__main__":
    main()
