"""
Camera interface for USB webcam
"""

import cv2
import numpy as np
from datetime import datetime
import os

import sys
sys.path.append('/home/pi/rice-paddy-monitor')
from config.settings import CAMERA_INDEX, CAMERA_WIDTH, CAMERA_HEIGHT, DATA_DIR


class Camera:
    """USB webcam interface"""
    
    def __init__(self, index=CAMERA_INDEX, width=CAMERA_WIDTH, height=CAMERA_HEIGHT):
        self.index = index
        self.width = width
        self.height = height
        self.cap = None
    
    def open(self):
        """Initialize camera connection"""
        self.cap = cv2.VideoCapture(self.index)
        
        if not self.cap.isOpened():
            raise RuntimeError(f"Failed to open camera at index {self.index}")
        
        # Set resolution
        self.cap.set(cv2.CAP_PROP_FRAME_WIDTH, self.width)
        self.cap.set(cv2.CAP_PROP_FRAME_HEIGHT, self.height)
        
        # Allow camera to warm up
        for _ in range(5):
            self.cap.read()
        
        print(f"Camera opened: {self.width}x{self.height}")
        return self
    
    def capture(self):
        """
        Capture a single frame.
        
        Returns:
            numpy.ndarray: BGR image or None on failure
        """
        if self.cap is None:
            self.open()
        
        ret, frame = self.cap.read()
        
        if not ret or frame is None:
            print("Failed to capture frame")
            return None
        
        return frame
    
    def capture_rgb(self):
        """
        Capture frame and convert to RGB.
        
        Returns:
            numpy.ndarray: RGB image or None on failure
        """
        frame = self.capture()
        if frame is not None:
            return cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        return None
    
    def save_image(self, frame=None, filename=None):
        """
        Save frame to file.
        
        Args:
            frame: Image to save (captures new if None)
            filename: Custom filename (auto-generates if None)
            
        Returns:
            str: Path to saved file
        """
        if frame is None:
            frame = self.capture()
        
        if frame is None:
            return None
        
        if filename is None:
            timestamp = datetime.now().strftime('%Y%m%d_%H%M%S')
            filename = f"capture_{timestamp}.jpg"
        
        filepath = os.path.join(DATA_DIR, filename)
        cv2.imwrite(filepath, frame)
        print(f"Image saved: {filepath}")
        return filepath
    
    def close(self):
        """Release camera resources"""
        if self.cap is not None:
            self.cap.release()
            self.cap = None
            print("Camera closed")
    
    def __enter__(self):
        return self.open()
    
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.close()


# Test camera if run directly
if __name__ == "__main__":
    print("Testing camera...")
    
    with Camera() as cam:
