"""
Sensor interface for DHT22 (temperature/humidity) and soil moisture
"""

import time
import board
import adafruit_dht
import busio
import adafruit_ads1x15.ads1115 as ADS
from adafruit_ads1x15.analog_in import AnalogIn

import sys
sys.path.append('/home/pi/rice-paddy-monitor')
from config.settings import (
    DHT_PIN, SOIL_MOISTURE_CHANNEL,
    SOIL_DRY, SOIL_WET
)


class DHTSensor:
    """Interface for DHT22 temperature and humidity sensor"""
    
    def __init__(self, pin=DHT_PIN):
        # Map GPIO number to board pin
        self.pin = getattr(board, f"D{pin}")
        self.sensor = adafruit_dht.DHT22(self.pin, use_pulseio=False)
        self._last_temp = None
        self._last_humidity = None
    
    def read(self, retries=3):
        """
        Read temperature and humidity with retry logic.
        DHT sensors are notoriously flaky, so retries are essential.
        
        Returns:
            dict: {'temperature': float, 'humidity': float} or None on failure
        """
        for attempt in range(retries):
            try:
                temperature = self.sensor.temperature
                humidity = self.sensor.humidity
                
                if temperature is not None and humidity is not None:
                    self._last_temp = temperature
                    self._last_humidity = humidity
                    return {
                        'temperature': round(temperature, 2),
                        'humidity': round(humidity, 2)
                    }
            except RuntimeError as e:
                # DHT sensors throw RuntimeError frequently, just retry
                print(f"DHT read attempt {attempt + 1} failed: {e}")
                time.sleep(2)  # DHT22 needs at least 2 seconds between reads
            except Exception as e:
                print(f"Unexpected DHT error: {e}")
                time.sleep(2)
        
        # Return last known good values if all retries fail
        if self._last_temp is not None:
            print("Returning cached DHT values")
            return {
                'temperature': self._last_temp,
                'humidity': self._last_humidity
            }
        return None
    
    def cleanup(self):
        """Release sensor resources"""
        self.sensor.exit()


class SoilMoistureSensor:
    """Interface for analog soil moisture sensor via ADS1115 ADC"""
    
    def __init__(self, channel=SOIL_MOISTURE_CHANNEL):
        # Initialize I2C
        self.i2c = busio.I2C(board.SCL, board.SDA)
        self.ads = ADS.ADS1115(self.i2c)
        
        # Set up the analog input channel
        self.channel = AnalogIn(self.ads, getattr(ADS, f"P{channel}"))
        
        # Calibration values
        self.dry_value = SOIL_DRY
        self.wet_value = SOIL_WET
    
    def read_raw(self):
        """Read raw ADC value"""
        return self.channel.value
    
    def read_voltage(self):
        """Read voltage value"""
        return self.channel.voltage
    
    def read_percentage(self):
        """
        Convert raw ADC reading to moisture percentage.
        0% = completely dry, 100% = saturated
        
        Returns:
            float: Moisture percentage (0-100)
        """
        raw = self.read_raw()
        
        # Map raw value to percentage (inverted because lower value = more wet)
        percentage = (self.dry_value - raw) / (self.dry_value - self.wet_value) * 100
        
        # Clamp to 0-100 range
        percentage = max(0, min(100, percentage))
        
        return round(percentage, 2)
    
    def read(self):
        """
        Read all soil moisture values.
        
        Returns:
            dict: {'raw': int, 'voltage': float, 'percentage': float}
        """
        return {
            'raw': self.read_raw(),
            'voltage': round(self.read_voltage(), 3),
            'percentage': self.read_percentage()
        }


class SensorHub:
    """Combined interface for all sensors"""
    
    def __init__(self):
        print("Initializing sensors...")
        self.dht = DHTSensor()
        self.soil = SoilMoistureSensor()
        print("Sensors initialized successfully")
    
    def read_all(self):
        """
        Read all sensors and return combined data.
        
        Returns:
            dict: Combined sensor readings with timestamp
        """
        dht_data = self.dht.read()
        soil_data = self.soil.read()
        
        return {
            'timestamp': time.strftime('%Y-%m-%d %H:%M:%S'),
            'temperature': dht_data['temperature'] if dht_data else None,
            'humidity': dht_data['humidity'] if dht_data else None,
            'soil_moisture_raw': soil_data['raw'],
            'soil_moisture_voltage': soil_data['voltage'],
            'soil_moisture_percent': soil_data['percentage']
        }
    
    def cleanup(self):
        """Clean up all sensor resources"""
        self.dht.cleanup()


# Test the sensors if run directly
if __name__ == "__main__":
    print("Testing sensors...")
    hub = SensorHub()
    
    try:
        for i in range(5):
            data = hub.read_all()
            print(f"\nReading {i+1}:")
            print(f"  Temperature: {data['temperature']}°C")
            print(f"  Humidity: {data['humidity']}%")
            print(f"  Soil Moisture: {data['soil_moisture_percent']}%")
            print(f"  Soil Raw ADC: {data['soil_moisture_raw']}")
            time.sleep(3)
    except KeyboardInterrupt:
        print("\nTest interrupted")
    finally:
        hub.cleanup()
        print("Sensors cleaned up")

