# Copy this file to secrets.toml and fill in the Supabase credentials.
# DO NOT commit secrets.toml to git!
#
# ============================================================
# DON'T HAVE THE KEYS? Contact Martin for the API credentials.
# He manages the Supabase project for this thesis.
# ============================================================
#
# For Streamlit Cloud deployment:
#   Go to your app settings → Secrets → paste these values.
#
# To get these values (if setting up a new Supabase project):
#   1. Go to https://supabase.com/dashboard
#   2. Open your project
#   3. Go to Settings → API
#   4. Copy the "Project URL" and "anon/public" key

SUPABASE_URL = "https://your-project-id.supabase.co"
SUPABASE_KEY = "your-anon-public-key-here"
