2. Network Fallback Logic

def get_active_connection():
    """Determine which network connection is active"""
    import subprocess
    result = subprocess.run(
        ['nmcli', '-t', '-f', 'TYPE,STATE', 'connection', 'show', '--active'],
        capture_output=True, text=True
    )
    
    connections = result.stdout.strip().split('\n')
    for conn in connections:
        if 'wifi:activated' in conn:
            return 'wifi'
        if 'gsm:activated' in conn:
            return 'nbiot'
        if 'ethernet:activated' in conn:
            return 'ethernet'
    
    return None
